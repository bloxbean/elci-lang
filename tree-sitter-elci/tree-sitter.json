{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "elci",
      "camelcase": "Elci",
      "title": "Elci",
      "scope": "source.elci",
      "path": ".",
      "file-types": [
        "elm"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^elci$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Elci grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/bloxbean/elci-lang"
    }
  }
}
